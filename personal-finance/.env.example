# Spring Boot Database & Security Configuration Example
# Replace the placeholder values with your actual local credentials.
# NEVER commit the real .env file or sensitive secrets to version control.

# MySQL Database Credentials
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# JWT Signing Secret (HMAC SHA-256 key, must be at least 256 bits / 32 characters long)
JWT_SECRET=your_secure_256_bit_jwt_secret_key_change_this_value_in_production
